[Unit]
Description=Classroom Xray REALITY proxy
Wants=network-online.target netbird.service wg-quick@wg-lab.service
After=network-online.target netbird.service wg-quick@wg-lab.service classlab-proxy-guard.service
Requires=classlab-proxy-guard.service

[Service]
User=xraylab
Group=xraylab
ExecStartPre=/usr/local/bin/xray-lab run -test -config /etc/classlab/xray-server.json
ExecStart=/usr/local/bin/xray-lab run -config /etc/classlab/xray-server.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
